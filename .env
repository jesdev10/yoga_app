# PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/yoga_db
# Leave blank to use local SQLite development database (bliss_mind.db):
DATABASE_URL=postgresql://postgres:Cowbelghgh1$@localhost:5432/bliss_yoga_db

# Security settings
ENVIRONMENT=development
SECRET_KEY=change-this-development-secret-before-deploying-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS frontend origins (Angular default is 4200)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
